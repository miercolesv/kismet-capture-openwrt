#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1
PROG=/usr/bin/kismet

add_source() {
	procd_append_param command -c "$1"
}

start_service() {
	config_load kismet

	local enabled logging log_prefix homedir
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || { echo "kismet: disabled in /etc/config/kismet"; return 0; }

	config_get_bool logging main logging 0
	config_get log_prefix main log_prefix ""
	config_get homedir main homedir /root

	procd_open_instance
	procd_set_param command "$PROG" --no-ncurses --homedir "$homedir"
	config_list_foreach main source add_source

	if [ "$logging" = 1 ] && [ -n "$log_prefix" ]; then
		if ! mkdir -p "$log_prefix" 2>/dev/null; then
			echo "kismet: cannot create $log_prefix, logging disabled"
			procd_append_param command -n
		else
			procd_append_param command -p "$log_prefix"
		fi
	else
		procd_append_param command -n
	fi

	procd_set_param env HOME="$homedir"
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger kismet
}
