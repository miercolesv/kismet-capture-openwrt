config kismet 'main'
	# 1 = start Kismet at boot (/etc/init.d/kismet enable && start)
	option enabled '0'
	# Local capture sources, one per line. The interface must exist and should
	# not be in use as an AP. Examples:
	#   list source 'wlan1:name=router-2g'
	#   list source 'wlan0:name=router-5g,channels="36,40,44,48"'
	# Remote sources can always connect without being listed here.
	# Logging writes a .kismet database continuously: keep it OFF unless
	# log_prefix points at external storage (microSD / USB), never flash.
	option logging '0'
	option log_prefix '/mnt/sda1/kismet'
	# Logging is refused when log_prefix is not on a mounted external drive.
	# Set to 1 only if you really want to log to flash or RAM (/tmp).
	option log_to_flash '0'
	# Where the web UI login (.kismet/kismet_httpd.conf) is kept.
	option homedir '/root'
